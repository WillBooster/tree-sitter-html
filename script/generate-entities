#!/usr/bin/env python3
import json
from pathlib import Path
from urllib.request import urlopen

source = 'https://html.spec.whatwg.org/entities.json'
with urlopen(source) as response:
    entities = json.load(response)
names = sorted({name[1:].rstrip(';') for name in entities})
lines = [
    '#ifndef TREE_SITTER_HTML_ENTITIES_H_',
    '#define TREE_SITTER_HTML_ENTITIES_H_',
    '',
    '#include <stdbool.h>',
    '',
    '// Generated by script/generate-entities from ' + source + '.',
    '#define HTML_ENTITY_NAME_MAX_LENGTH ' + str(max(map(len, names))),
    '',
    'typedef struct {',
    '    const char *name;',
    '    bool legacy;',
    '} HtmlEntityName;',
    '',
    'static const HtmlEntityName HTML_ENTITY_NAMES[] = {',
]
lines.extend('    {"' + name + '", ' + str('&' + name in entities).lower() + '},' for name in names)
lines.extend(['};', '', '#endif', ''])
(Path(__file__).resolve().parent.parent / 'src/entities.h').write_text('\n'.join(lines))
