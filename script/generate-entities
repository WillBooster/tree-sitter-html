#!/usr/bin/env python3
from bisect import bisect_left
import json
from pathlib import Path
from urllib.request import urlopen

source = 'https://html.spec.whatwg.org/entities.json'
with urlopen(source) as response:
    entities = json.load(response)
names = sorted({name[1:].rstrip(';') for name in entities})
assert all(('A' <= name[0] <= 'Z') or ('a' <= name[0] <= 'z') for name in names)

first_chars = [ord(name[0]) for name in names]
first_char_offsets = [bisect_left(first_chars, code) for code in range(ord('A'), ord('z') + 2)]

suffix_parts = []
entries = []
offset = 0
for name in names:
    legacy = int('&' + name in entities)
    entries.append((offset << 1) | legacy)
    suffix = name[1:]
    suffix_parts.append(suffix)
    offset += len(suffix)
entries.append(offset << 1)
assert offset < (1 << 15)
suffixes = ''.join(suffix_parts)


def chunked(items, size, separator=', '):
    for index in range(0, len(items), size):
        yield '    ' + separator.join(items[index : index + size]) + ','


lines = [
    '#ifndef TREE_SITTER_HTML_ENTITIES_H_',
    '#define TREE_SITTER_HTML_ENTITIES_H_',
    '',
    '#include <stdint.h>',
    '',
    '// Generated by script/generate-entities from ' + source + '.',
    '#define HTML_ENTITY_NAME_MAX_LENGTH ' + str(max(map(len, names))),
    '',
    'static const uint16_t HTML_ENTITY_FIRST_CHAR_OFFSET[' + str(len(first_char_offsets)) + '] = {',
    *chunked([str(value) for value in first_char_offsets], 16),
    '};',
    '',
    'static const uint16_t HTML_ENTITY_ENTRIES[' + str(len(entries)) + '] = {',
    *chunked([str(value) for value in entries], 16),
    '};',
    '',
    'static const char HTML_ENTITY_SUFFIXES[' + str(len(suffixes)) + '] = {',
    *chunked(["'" + ch + "'" for ch in suffixes], 24, ','),
    '};',
    '',
    '#endif',
    '',
]
(Path(__file__).resolve().parent.parent / 'src/entities.h').write_text('\n'.join(lines))
