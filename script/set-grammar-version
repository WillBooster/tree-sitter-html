#!/usr/bin/env node
const fs = require('node:fs');
const path = require('node:path');

const version = process.argv[2];
const match = /^(\d+)\.(\d+)\.(\d+)/.exec(version ?? '');
if (!match) throw new Error('Usage: script/set-grammar-version <major.minor.patch>');

const root = path.join(__dirname, '..');
const configFile = path.join(root, 'tree-sitter.json');
const config = JSON.parse(fs.readFileSync(configFile, 'utf8'));
config.metadata.version = version;
fs.writeFileSync(configFile, `${JSON.stringify(config, null, 2)}\n`);

const manifestFile = path.join(root, 'Cargo.toml');
const manifest = fs.readFileSync(manifestFile, 'utf8');
const crateVersion = /^(version = )"[^"]*"/m;
if (!crateVersion.test(manifest)) throw new Error('Cargo.toml has no package version');
fs.writeFileSync(manifestFile, manifest.replace(crateVersion, `$1"${version}"`));

const packageFile = path.join(root, 'package.json');
const pkg = JSON.parse(fs.readFileSync(packageFile, 'utf8'));
pkg.version = version;
fs.writeFileSync(packageFile, `${JSON.stringify(pkg, null, 2)}\n`);
