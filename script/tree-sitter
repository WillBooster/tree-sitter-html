#!/usr/bin/env bash

# Runs the tree-sitter CLI of WillBooster/tree-sitter at the runtime version that script/runtime-version prints with the
# given arguments, so that the parser is generated, built, and tested by the generator and runtime this package ships
# with. The first run downloads that CLI into .tmp/ from the GitHub Release of the version, or builds it when the
# download fails or the release has no binary that runs here, which takes over 10 minutes on GitHub's Intel macOS
# runner.

set -euo pipefail

root=$(cd "$(dirname "$0")/.." && pwd)
version=$("$root/script/runtime-version")
cli=$root/.tmp/tree-sitter-cli/$version
if [[ ! -x $cli/bin/tree-sitter ]]; then
  case $(uname -s)-$(uname -m) in
    Linux-x86_64) platform=linux-x64 ;;
    Linux-aarch64) platform=linux-arm64 ;;
    Darwin-arm64) platform=macos-arm64 ;;
    Darwin-x86_64) platform=macos-x64 ;;
    *) platform= ;;
  esac
  # Runs in the same checkout may overlap, so each stages the CLI in a directory of its own and publishes it with an
  # atomic `mv`; a run that loses the race replaces the binary with an identical one.
  mkdir -p "$cli/bin"
  staging=$(mktemp -d "$cli/staging.XXXXXX")
  trap 'rm -rf "$staging"' EXIT
  # A binary that does not run here (e.g. on an older glibc than the release's build) is replaced by a build as well.
  # Without a connection timeout below curl's default of 5 minutes and a speed limit, a stalled connection or transfer
  # would hold up the tests for a long time instead of falling back to the build.
  # The archive is saved before extraction because a retry restarts the transfer, which a pipe into tar cannot undo.
  if [[ -n $platform ]] && curl --fail --silent --show-error --location --retry 3 --connect-timeout 30 \
    --speed-limit 1024 --speed-time 60 --output "$staging/cli.tar.gz" \
    "https://github.com/WillBooster/tree-sitter/releases/download/v$version/tree-sitter-cli-$platform.tar.gz" &&
    tar -xzf "$staging/cli.tar.gz" -C "$staging" && "$staging/tree-sitter" --version > /dev/null; then
    mv "$staging/tree-sitter" "$cli/bin/tree-sitter"
  else
    # `tree-sitter test --wasm` needs the `wasm` feature, which the released binaries are built with as well; its wasmtime
    # build runs cmake, which mise.toml pins.
    cargo install --quiet --locked --features wasm --root "$staging/root" \
      --git https://github.com/WillBooster/tree-sitter --tag "v$version" tree-sitter-cli >&2
    mv "$staging/root/bin/tree-sitter" "$cli/bin/tree-sitter"
  fi
  rm -rf "$staging"
  trap - EXIT
fi
exec "$cli/bin/tree-sitter" "$@"
