{
  "name": "@willbooster/tree-sitter-html",
  "version": "0.0.0-semantically-released",
  "description": "HTML grammar for tree-sitter",
  "keywords": [
    "incremental",
    "parsing",
    "tree-sitter",
    "html"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/WillBooster/tree-sitter-html.git"
  },
  "license": "MIT",
  "author": "WillBooster Inc.",
  "files": [
    "grammar.js",
    "queries/*.scm",
    "src/node-types.json",
    "tree-sitter.json",
    "*.wasm"
  ],
  "scripts": {
    "build-wasm": "script/generate --build-wasm",
    "build/ci": "bun run build-wasm",
    "cleanup": "bun wb lint --fix --format",
    "format": "bun wb lint --format",
    "generate": "script/generate",
    "lint": "bun wb lint",
    "lint-fix": "bun wb lint --fix",
    "prepare": "(bun lefthook install || true) && (test ! -f .lefthook/normalize-bun-lockfile.sh || bash .lefthook/normalize-bun-lockfile.sh)",
    "release": "wb release",
    "prestart": "bun run build-wasm",
    "start": "script/tree-sitter playground",
    "test": "bun wb test",
    "test/ci": "bun wb test-on-ci",
    "test/ci-setup": "playwright install --with-deps chromium",
    "typecheck": "bun wb typecheck",
    "verify": "bun wb verify",
    "verify-full": "bun wb verify --full"
  },
  "devDependencies": {
    "@tsconfig/bun": "1.0.11",
    "@types/bun": "1.4.2",
    "@vitest/browser-playwright": "5.0.3",
    "@willbooster/oxfmt-config": "1.2.2",
    "@willbooster/oxlint-config": "1.4.8",
    "@willbooster/wb": "22.24.0",
    "@willbooster/web-tree-sitter": "2.0.1",
    "conventional-changelog-conventionalcommits": "10.4.0",
    "lefthook": "2.1.16",
    "oxfmt": "0.71.0",
    "oxlint": "1.86.0",
    "oxlint-tsgolint": "7.0.2003",
    "playwright": "1.63.0",
    "semantic-release": "25.0.9",
    "sort-package-json": "4.0.0",
    "typescript": "7.0.2",
    "vitest": "5.0.3",
    "wrangler": "4.147.0"
  },
  "peerDependencies": {
    "@willbooster/web-tree-sitter": "^2.0.0"
  },
  "peerDependenciesMeta": {
    "@willbooster/web-tree-sitter": {
      "optional": true
    }
  },
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org/"
  }
}
